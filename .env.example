# ─────────────────────────────────────────────────────────────────────────────
# AI Desktop Pro — environment
#
# Copy to `.env.local` and fill in as needed. The app runs fully in DEMO mode
# with NO env at all; the variables below only matter for the live backend path.
# ─────────────────────────────────────────────────────────────────────────────

# Data-source mode. Default (unset/false) = demo/mock, nothing is persisted.
# "true" (or "1") routes the wired vertical slice through the real backend.
NEXT_PUBLIC_USE_LIVE_API=false

# ── Live backend (server-only; NEVER prefixed NEXT_PUBLIC — must stay server-side)
# Transitional endpoint for live domains that have not moved into the
# Desktop-owned boundary yet (ADR 0003). Migrated domains do not use it.
TRPC_BASE_URL=http://localhost:3000/api/trpc

# ⚠️ LOCAL/E2E FALLBACK ONLY. In real deployments the active organization is
# selected at sign-in from the practitioner's own memberships (httpOnly
# aidp_org cookie, switchable in Settings) and validated server-side. This
# env var only fills in when no session org exists (contract-fixture e2e,
# headless local runs). Do NOT set in production.
CLINICAL_ORG_ID=

# Clinical project Auth + Data API endpoint. Used only from server routes and
# server adapters with the publishable key plus the practitioner's JWT; the
# browser never receives either token or key. Required for migrated live
# domains and /login. Never put a service-role key here.
CLINICAL_SUPABASE_URL=
CLINICAL_SUPABASE_ANON_KEY=

# ── Target production clinical core (AWS)
# The current Supabase project is synthetic staging only. These values describe
# the future production data plane; setting them does not itself authorize PHI.
# Connector/vendor and runtime approvals remain durable governed records. The
# app stays unavailable if only these environment variables are configured.
CLINICAL_DATA_PLANE=supabase_staging
CLINICAL_AWS_REGION=
CLINICAL_AWS_API_ORIGIN=
CLINICAL_AWS_ALLOWED_API_HOSTS=

# ⚠️ LOCAL/E2E FALLBACK ONLY. Real live mode signs in at /login (httpOnly
# cookie session); these env credentials are used only when no session exists,
# so the contract-fixture e2e suite can run headless. Do NOT set in production.
CLINICAL_DEMO_EMAIL=
CLINICAL_DEMO_PASSWORD=

# ── Dev-only identity overrides  ⚠️ LOCAL DEVELOPMENT ONLY — UNSAFE FOR PRODUCTION
# These pin an org/patient/practitioner before the login UI exists. They are NOT
# authentication: the backend still enforces RLS against the real session token.
# Never set these in a deployed environment.
NEXT_PUBLIC_DEV_ORG_ID=
NEXT_PUBLIC_DEV_PATIENT_ID=
NEXT_PUBLIC_DEV_PRACTITIONER_ID=
