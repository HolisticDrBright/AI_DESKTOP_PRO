# ─────────────────────────────────────────────────────────────────────────────
# AI Desktop Pro — environment
#
# Copy to `.env.local` and fill in as needed. The app runs fully in DEMO mode
# with NO env at all; the variables below only matter for the live backend path.
# ─────────────────────────────────────────────────────────────────────────────

# Data-source mode. Default (unset/false) = demo/mock, nothing is persisted.
# "true" (or "1") routes the wired vertical slice through the real backend.
NEXT_PUBLIC_USE_LIVE_API=false

# Separate reviewed AWS workforce recording endpoints; server-only. Leave blank
# until their individual deployment/activation gates are satisfied. Configuring
# one never supplies a fallback for the other and never enables microphone UI.
RECORDING_AWS_API_ORIGIN=
RECORDING_CAPTURE_AWS_API_ORIGIN=
RECORDING_TRANSCRIPTION_AWS_API_ORIGIN=
RECORDING_DRAFTING_AWS_API_ORIGIN=

# ── Live backend (server-only; NEVER prefixed NEXT_PUBLIC — must stay server-side)
# Transitional endpoint for live domains that have not moved into the
# Desktop-owned boundary yet (ADR 0003). Migrated domains do not use it.
TRPC_BASE_URL=http://localhost:3000/api/trpc

# ⚠️ LOCAL/E2E FALLBACK ONLY. In real deployments the active organization is
# selected at sign-in from the practitioner's own memberships (httpOnly
# aidp_org cookie, switchable in Settings) and validated server-side. This
# env var only fills in when no session org exists (contract-fixture e2e,
# headless local runs). Do NOT set in production.
CLINICAL_ORG_ID=

# Clinical project Auth + Data API endpoint. Used only from server routes and
# server adapters with the publishable key plus the practitioner's JWT; the
# browser never receives either token or key. Required for migrated live
# domains and /login. Never put a service-role key here.
CLINICAL_SUPABASE_URL=
CLINICAL_SUPABASE_ANON_KEY=

# ── Target production clinical core (AWS)
# The current Supabase project is synthetic staging only. These values describe
# the future production data plane; setting them does not itself authorize PHI.
# Connector/vendor and runtime approvals remain durable governed records. The
# app stays unavailable if only these environment variables are configured.
CLINICAL_DATA_PLANE=supabase_staging
CLINICAL_AWS_REGION=
CLINICAL_AWS_API_ORIGIN=
CLINICAL_AWS_ALLOWED_API_HOSTS=
# Synthetic acceptance only. This never authorizes PHI or production use.
# The app-side route requires a workforce Cognito ID token; Supabase sessions
# are deliberately not treated as Cognito identities.
CLINICAL_AWS_RUNTIME_MODE=disabled

# ⚠️ LOCAL/E2E FALLBACK ONLY. Real live mode signs in at /login (httpOnly
# cookie session); these env credentials are used only when no session exists,
# so the contract-fixture e2e suite can run headless. Do NOT set in production.
CLINICAL_DEMO_EMAIL=
CLINICAL_DEMO_PASSWORD=

# ── Dev-only identity overrides  ⚠️ LOCAL DEVELOPMENT ONLY — UNSAFE FOR PRODUCTION
# These pin an org/patient/practitioner before the login UI exists. They are NOT
# authentication: the backend still enforces RLS against the real session token.
# Never set these in a deployed environment.
NEXT_PUBLIC_DEV_ORG_ID=
NEXT_PUBLIC_DEV_PATIENT_ID=
NEXT_PUBLIC_DEV_PRACTITIONER_ID=

# ── Telehealth (Zoom) — NOT environment variables.
# Zoom credentials live only in AWS Secrets Manager, read by the telehealth
# Lambda (infra/aws-clinical-core/telehealth-requests-extension.json). The
# desktop reaches visits through CLINICAL_AWS_WORKFORCE_API_ORIGIN above. The
# secret shape and required Zoom scopes are documented in docs/telehealth.md.
# There is no NEXT_PUBLIC_ Zoom value: the SDK signature is issued per visit.

# ── Fullscript Integrate (server-only)
# Put these values in AWS Secrets Manager and inject them only into the server
# runtime. Never use NEXT_PUBLIC_ names and never copy the secret into V2.
FULLSCRIPT_ENVIRONMENT=sandbox_us
FULLSCRIPT_CLIENT_ID=
FULLSCRIPT_CLIENT_SECRET=
FULLSCRIPT_OAUTH_AUTHORIZE_URL=https://api-us-snd.fullscript.io/api/oauth/authorize
FULLSCRIPT_REDIRECT_URI=https://YOUR_DESKTOP_HOST/api/live/fullscript/oauth/callback
FULLSCRIPT_OAUTH_STATE_SECRET=
FULLSCRIPT_TOKEN_TABLE=
FULLSCRIPT_LAB_ORDERING_ENABLED=false
# Production remains refused unless Fullscript approves the integration and
# both flags below are explicitly true in the production clinical runtime.
FULLSCRIPT_PRODUCTION_APPROVED=false
PHI_ALLOWED=false

# ── Campaign engine (marketing package; commercial data only, server-only)
# Off unless exactly "true": /join pages and the three public campaign routes
# answer not-found, the Campaigns screen says the engine is off, and no program
# page shows "Get updates". The engine itself runs in its own Lambdas
# (infra/campaigns/campaign-engine.json); the Desktop only forwards to its API.
CAMPAIGN_ENGINE_ENABLED=false
# The campaign HTTP API (an execute-api https origin and nothing else).
CAMPAIGN_API_ORIGIN=
# The practice whose /join page this deployment's program pages link to.
FUNNEL_PRACTICE_SLUG=

# ── Consult enquirer email (server-only) — OFF by default.
# "We received your request", sent by the public consult route after a request
# is received, through the clinic's own alp-transactional SES configuration set
# (never the campaign service). Needs SES production access first. The telehealth
# Lambda has its own CONSULT_ENQUIRER_EMAILS_ENABLED and CLINIC_DISPLAY_NAME for
# "Your consultation is booked" (infra/aws-clinical-core/telehealth-requests-extension.json).
CONSULT_ENQUIRER_EMAILS_ENABLED=false
CONSULT_ENQUIRER_SENDER=
CONSULT_ENQUIRER_CONFIGURATION_SET=alp-transactional
CONSULT_ENQUIRER_CONTACT_LINE=
