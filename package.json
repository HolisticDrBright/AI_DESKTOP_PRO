    "test:e2e:headed": "playwright test --headed",
    "test:unit": "cross-env TZ=America/Los_Angeles vitest run",
    "build:clinical": "cross-env APP_EDITION=clinical next build",
    "check:clinical-bundle": "node scripts/check-clinical-bundle.mjs",
    "check:mock-imports": "node scripts/check-mock-imports.mjs",
    "sync:worker": "node scripts/sync/worker.mjs",
    "check:stub-reset": "node scripts/check-stub-reset-coverage.mjs",
    "test:e2e:order": "node scripts/check-e2e-order-independence.mjs",
    "check:aws-clinical-core": "node scripts/check-aws-clinical-core.mjs",
    "check:aws-identity-consent": "node scripts/check-aws-identity-consent.mjs",
    "check:aws-authenticated-api": "node scripts/check-aws-authenticated-api.mjs",
    "build:aws-authenticated-api": "node scripts/build-aws-authenticated-api.mjs",
    "build:aws-lab-analysis": "node scripts/build-aws-lab-analysis.mjs",
    "build:aws-deployment-tools": "node scripts/build-aws-deployment-tools.mjs",
