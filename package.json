    "@aws-sdk/client-secrets-manager": "^3.1103.0",
    "@aws-sdk/client-sfn": "^3.1109.0",
    "@aws-sdk/client-textract": "^3.1109.0",
    "@aws-sdk/lib-dynamodb": "^3.1109.0",
    "@aws-sdk/s3-request-presigner": "^3.1109.0",
    "@tanstack/react-query": "^5.101.2",
    "lucide-react": "^1.24.0",
    "next": "^15.5.20",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
