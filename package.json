  "private": true,
  "description": "AI Longevity Pro — Clinical Intelligence. Desktop-first practitioner platform (Phase 1 front end).",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
