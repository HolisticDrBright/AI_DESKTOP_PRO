    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.20",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vitest": "4.1.5"
  },
  "overrides": {
    "postcss": "^8.5.10"
