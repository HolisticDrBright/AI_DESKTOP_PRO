                      ]
                    },
                    {
                      "Fn::Sub": "${CampaignTable.Arn}/index/due"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "kms:Decrypt",
                    "kms:Encrypt",
                    "kms:GenerateDataKey"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "CampaignKey",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": {
                    "Ref": "CampaignKeySecret"
                  }
                }
              ]
            }
          },
          {
            "PolicyName": "MarketingSendOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "SendFromMarketingIdentities",
                  "Effect": "Allow",
                  "Action": "ses:SendEmail",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ses:${AWS::Region}:${AWS::AccountId}:identity/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "aws:ResourceTag/alp-purpose": "marketing"
                    }
                  }
                },
                {
                  "Sid": "ThroughMarketingSets",
                  "Effect": "Allow",
                  "Action": "ses:SendEmail",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ses:${AWS::Region}:${AWS::AccountId}:configuration-set/alp-marketing"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ses:${AWS::Region}:${AWS::AccountId}:configuration-set/alp-marketing-tracked"
                    }
                  ]
                },
                {
                  "Sid": "AsPracticeTenants",
                  "Effect": "Allow",
                  "Action": "ses:SendEmail",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ses:${AWS::Region}:${AWS::AccountId}:tenant/alp-practice-*"
                  }
                },
                {
                  "Sid": "NeverTransactional",
                  "Effect": "Deny",
                  "Action": "ses:*",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ses:${AWS::Region}:${AWS::AccountId}:configuration-set/alp-transactional"
                  }
                },
                {
                  "Sid": "SendingRate",
                  "Effect": "Allow",
                  "Action": "ses:GetAccount",
                  "Resource": "*"
                }
              ]
            }
          },
          {
            "PolicyName": "StaffRevocationSignal",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "ReadStaffRevocationSignal",
                  "Effect": "Allow",
                  "Action": "dynamodb:GetItem",
                  "Resource": {
                    "Fn::GetAtt": [
                      "CampaignStaffRevocationTable",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "alp-purpose",
            "Value": "marketing"
          }
        ]
      }
    },
    "CampaignEventsRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "Logs",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "CampaignEventsLogs",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          },
          {
            "PolicyName": "CampaignTable",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:DeleteItem",
                    "dynamodb:Query",
                    "dynamodb:ConditionCheckItem"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "CampaignTable",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::Sub": "${CampaignTable.Arn}/index/due"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "kms:Decrypt",
                    "kms:Encrypt",
                    "kms:GenerateDataKey"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "CampaignKey",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": {
                    "Ref": "CampaignKeySecret"
                  }
                }
              ]
            }
          },
          {
            "PolicyName": "DeadLetters",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "sqs:SendMessage",
                  "Resource": {
                    "Fn::GetAtt": [
                      "CampaignEventsDeadLetters",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "alp-purpose",
            "Value": "marketing"
          }
        ]
      }
    },
    "CampaignApiFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": "alp-campaign-api",
        "Runtime": "nodejs22.x",
        "Handler": "index.handler",
        "Architectures": [
          "arm64"
        ],
        "MemorySize": 512,
        "Timeout": 15,
        "Role": {
          "Fn::GetAtt": [
            "CampaignApiRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "LambdaCodeBucket"
          },
          "S3Key": {
            "Ref": "ApiCodeKey"
          }
        },
        "KmsKeyArn": {
          "Fn::GetAtt": [
            "CampaignKey",
            "Arn"
          ]
        },
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "CampaignApiLogs"
          }
        },
        "Environment": {
          "Variables": {
            "CAMPAIGN_ENGINE_ENABLED": {
              "Ref": "CampaignEngineEnabled"
            },
            "CAMPAIGN_TABLE_NAME": {
              "Ref": "CampaignTable"
            },
            "CAMPAIGN_KEY_SECRET_ARN": {
              "Ref": "CampaignKeySecret"
            },
            "CAMPAIGN_SITE_ORIGIN": {
              "Ref": "SiteOrigin"
            },
            "CAMPAIGN_CONFIGURATION_SET": {
              "Ref": "MarketingSet"
            },
            "CAMPAIGN_TRACKED_CONFIGURATION_SET": {
              "Ref": "MarketingTrackedSet"
            },
            "CAMPAIGN_FROM_LOCAL_PART": {
              "Ref": "FromLocalPart"
            },
            "CAMPAIGN_ACCOUNT_ID": {
              "Ref": "AWS::AccountId"
            },
            "CAMPAIGN_STAFF_REVOCATION_TABLE": {
              "Ref": "CampaignStaffRevocationTable"
            }
          }
        },
        "Tags": [
          {
            "Key": "alp-purpose",
            "Value": "marketing"
          }
        ]
      }
    },
    "CampaignSenderFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": "alp-campaign-sender",
        "Runtime": "nodejs22.x",
        "Handler": "index.handler",
        "Architectures": [
          "arm64"
        ],
        "MemorySize": 512,
        "Timeout": 300,
        "Role": {
          "Fn::GetAtt": [
            "CampaignSenderRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "LambdaCodeBucket"
          },
          "S3Key": {
            "Ref": "SenderCodeKey"
          }
        },
        "KmsKeyArn": {
          "Fn::GetAtt": [
            "CampaignKey",
            "Arn"
          ]
        },
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "CampaignSenderLogs"
          }
        },
        "Environment": {
          "Variables": {
            "CAMPAIGN_ENGINE_ENABLED": {
              "Ref": "CampaignEngineEnabled"
            },
            "CAMPAIGN_TABLE_NAME": {
              "Ref": "CampaignTable"
            },
            "CAMPAIGN_KEY_SECRET_ARN": {
              "Ref": "CampaignKeySecret"
            },
            "CAMPAIGN_SITE_ORIGIN": {
              "Ref": "SiteOrigin"
            },
            "CAMPAIGN_CONFIGURATION_SET": {
              "Ref": "MarketingSet"
            },
            "CAMPAIGN_TRACKED_CONFIGURATION_SET": {
              "Ref": "MarketingTrackedSet"
            },
            "CAMPAIGN_FROM_LOCAL_PART": {
              "Ref": "FromLocalPart"
            },
            "CAMPAIGN_ACCOUNT_ID": {
              "Ref": "AWS::AccountId"
            },
            "CAMPAIGN_STAFF_REVOCATION_TABLE": {
              "Ref": "CampaignStaffRevocationTable"
            }
          }
        },
        "Tags": [
          {
            "Key": "alp-purpose",
            "Value": "marketing"
          }
        ],
        "ReservedConcurrentExecutions": 1
      }
    },
    "CampaignEventsFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": "alp-campaign-events",
        "Runtime": "nodejs22.x",
        "Handler": "index.handler",
        "Architectures": [
          "arm64"
        ],
        "MemorySize": 512,
        "Timeout": 30,
        "Role": {
          "Fn::GetAtt": [
            "CampaignEventsRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "LambdaCodeBucket"
          },
          "S3Key": {
            "Ref": "EventsCodeKey"
          }
        },
        "KmsKeyArn": {
          "Fn::GetAtt": [
            "CampaignKey",
            "Arn"
          ]
        },
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "CampaignEventsLogs"
          }
        },
        "Environment": {
          "Variables": {
            "CAMPAIGN_ENGINE_ENABLED": {
              "Ref": "CampaignEngineEnabled"
            },
            "CAMPAIGN_TABLE_NAME": {
              "Ref": "CampaignTable"
            },
            "CAMPAIGN_KEY_SECRET_ARN": {
              "Ref": "CampaignKeySecret"
            },
            "CAMPAIGN_SITE_ORIGIN": {
              "Ref": "SiteOrigin"
            },
            "CAMPAIGN_CONFIGURATION_SET": {
              "Ref": "MarketingSet"
            },
            "CAMPAIGN_TRACKED_CONFIGURATION_SET": {
              "Ref": "MarketingTrackedSet"
            },
            "CAMPAIGN_FROM_LOCAL_PART": {
              "Ref": "FromLocalPart"
            },
            "CAMPAIGN_ACCOUNT_ID": {
              "Ref": "AWS::AccountId"
            },
            "CAMPAIGN_EVENTS_TOPIC_ARN": {
              "Ref": "CampaignEventsTopic"
            }
          }
        },
        "Tags": [
          {
            "Key": "alp-purpose",
            "Value": "marketing"
          }
        ],
        "DeadLetterConfig": {
          "TargetArn": {
            "Fn::GetAtt": [
              "CampaignEventsDeadLetters",
              "Arn"
            ]
          }
        }
      }
    },
    "CampaignHttpApi": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": "alp-campaign-api",
        "ProtocolType": "HTTP",
        "DisableExecuteApiEndpoint": false
      }
    },
    "CampaignStaffAuthorizer": {
      "Type": "AWS::ApiGatewayV2::Authorizer",
      "Properties": {
        "ApiId": {
          "Ref": "CampaignHttpApi"
        },
        "AuthorizerType": "JWT",
        "Name": "workforce",
        "IdentitySource": [
          "$request.header.Authorization"
        ],
        "JwtConfiguration": {
          "Issuer": {
            "Ref": "WorkforceIssuer"
          },
          "Audience": [
            {
              "Ref": "WorkforceAudience"
            }
          ]
        }
      }
    },
    "CampaignApiIntegration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "CampaignHttpApi"
        },
        "IntegrationType": "AWS_PROXY",
        "IntegrationUri": {
          "Fn::GetAtt": [
            "CampaignApiFunction",
            "Arn"
          ]
        },
        "PayloadFormatVersion": "2.0",
        "TimeoutInMillis": 15000
      }
    },
    "RoutePublicJoinPage": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "CampaignHttpApi"
        },
        "RouteKey": "GET /campaigns/public/join/{practice}/{program}",
        "Target": {
          "Fn::Sub": "integrations/${CampaignApiIntegration}"
        },
        "AuthorizationType": "NONE"
      }
    },
    "RoutePublicSignupOpen": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "CampaignHttpApi"
        },
        "RouteKey": "GET /campaigns/public/signup-open/{practice}/{program}",
        "Target": {
          "Fn::Sub": "integrations/${CampaignApiIntegration}"
        },
        "AuthorizationType": "NONE"
      }
    },
    "RoutePublicJoin": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "CampaignHttpApi"
        },
        "RouteKey": "POST /campaigns/public/join",
        "Target": {
          "Fn::Sub": "integrations/${CampaignApiIntegration}"
        },
        "AuthorizationType": "NONE"
      }
    },
    "RoutePublicConfirm": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "CampaignHttpApi"
        },
        "RouteKey": "POST /campaigns/public/confirm",
        "Target": {
          "Fn::Sub": "integrations/${CampaignApiIntegration}"
        },
        "AuthorizationType": "NONE"
      }
    },
    "RoutePublicUnsubscribe": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "CampaignHttpApi"
        },
        "RouteKey": "POST /campaigns/public/unsubscribe",
        "Target": {
          "Fn::Sub": "integrations/${CampaignApiIntegration}"
        },
        "AuthorizationType": "NONE"
      }
    },
    "RouteStaff": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "CampaignHttpApi"
        },
        "RouteKey": "POST /campaigns/workforce",
        "Target": {
          "Fn::Sub": "integrations/${CampaignApiIntegration}"
        },
        "AuthorizationType": "JWT",
        "AuthorizerId": {
          "Ref": "CampaignStaffAuthorizer"
        }
      }
    },
    "CampaignApiStage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "Properties": {
        "ApiId": {
          "Ref": "CampaignHttpApi"
        },
        "StageName": "$default",
        "AutoDeploy": true,
        "DefaultRouteSettings": {
          "ThrottlingBurstLimit": 20,
          "ThrottlingRateLimit": 10
        },
        "AccessLogSettings": {
          "DestinationArn": {
            "Fn::GetAtt": [
              "CampaignApiAccessLogs",
              "Arn"
            ]
          },
          "Format": "{\"requestId\": \"$context.requestId\", \"routeKey\": \"$context.routeKey\", \"status\": \"$context.status\", \"latency\": \"$context.responseLatency\"}"
        }
      }
    },
    "CampaignApiInvoke": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "CampaignApiFunction"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${CampaignHttpApi}/*"
        }
      }
    },
    "CampaignEventsSubscription": {
      "Type": "AWS::SNS::Subscription",
      "Properties": {
        "TopicArn": {
          "Ref": "CampaignEventsTopic"
        },
        "Protocol": "lambda",
        "Endpoint": {
          "Fn::GetAtt": [
            "CampaignEventsFunction",
            "Arn"
          ]
        }
      }
    },
    "CampaignEventsInvoke": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "CampaignEventsFunction"
        },
        "Principal": "sns.amazonaws.com",
        "SourceArn": {
          "Ref": "CampaignEventsTopic"
        }
      }
    },
    "CampaignScheduleRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "scheduler.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "InvokeSender",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "lambda:InvokeFunction",
                  "Resource": {
                    "Fn::GetAtt": [
                      "CampaignSenderFunction",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "CampaignSendSchedule": {
      "Type": "AWS::Scheduler::Schedule",
      "Properties": {
        "Name": "alp-campaign-send",
        "Description": "Every 5 minutes: send due sequence steps and broadcasts. Idempotent per send.",
        "ScheduleExpression": "rate(5 minutes)",
        "State": {
          "Ref": "SendScheduleState"
        },
        "FlexibleTimeWindow": {
          "Mode": "OFF"
        },
        "Target": {
          "Arn": {
            "Fn::GetAtt": [
              "CampaignSenderFunction",
              "Arn"
            ]
          },
          "RoleArn": {
            "Fn::GetAtt": [
              "CampaignScheduleRole",
              "Arn"
            ]
          },
          "RetryPolicy": {
            "MaximumRetryAttempts": 0
          }
        }
      }
    }
  },
  "Outputs": {
    "CampaignApiOrigin": {
      "Value": {
        "Fn::Sub": "https://${CampaignHttpApi}.execute-api.${AWS::Region}.amazonaws.com"
      },
      "Description": "CAMPAIGN_API_ORIGIN for the Desktop."
    },
    "CampaignTableName": {
      "Value": {
        "Ref": "CampaignTable"
      }
    },
    "CampaignEventsTopicArn": {
      "Value": {
        "Ref": "CampaignEventsTopic"
      }
    },
    "CampaignStaffRevocationTableArn": {
      "Value": {
        "Fn::GetAtt": [
          "CampaignStaffRevocationTable",
          "Arn"
        ]
      },
      "Description": "The staff revocation signal (staff-revocation-signal/1). The campaign API may only read it; the emergency revocation's operator host is granted PutItem on it alone, outside this template."
    }
  }
}
