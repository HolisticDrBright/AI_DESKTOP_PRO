{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "AI Desktop Pro campaign engine (commercial; email to people who are not patients yet). Its own table, key, API, functions, SES configuration sets and schedule; no route to or credential for anything clinical. Written and validated, not applied. Every switch defaults off.",
  "Metadata": {
    "alp:commercial": true,
    "alp:defaultsOff": [
      "CampaignEngineEnabled=false",
      "SendScheduleState=DISABLED"
    ],
    "alp:noClinicalAccess": true
  },
  "Parameters": {
    "CampaignEngineEnabled": {
      "Type": "String",
      "AllowedValues": [
        "false",
        "true"
      ],
      "Default": "false",
      "Description": "CAMPAIGN_ENGINE_ENABLED for every campaign Lambda. false: every route answers 503 and the sending job does nothing."
    },
    "SendScheduleState": {
      "Type": "String",
      "AllowedValues": [
        "DISABLED",
        "ENABLED"
      ],
      "Default": "DISABLED",
      "Description": "The 5-minute sending schedule. Stays DISABLED until Brandon switches campaign sending on."
    },
    "SiteOrigin": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^https://[a-z0-9.-]+$",
      "Description": "The Desktop's public https origin (program pages, /join, unsubscribe). No default: Brandon chooses the public address."
    },
    "FromLocalPart": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^[a-z0-9]([a-z0-9._-]{0,30}[a-z0-9])?$",
      "Description": "The local part every practice sends from: <local part>@<practice domain>. No default."
    },
    "WorkforceIssuer": {
      "Type": "String",
      "Default": "https://cognito-idp.us-east-2.amazonaws.com/us-east-2_unset",
      "Description": "The workforce Cognito pool's issuer, for the staff route's JWT authorizer."
    },
    "WorkforceAudience": {
      "Type": "String",
      "Default": "unset",
      "Description": "The workforce app client id, for the staff route's JWT authorizer."
    },
    "LambdaCodeBucket": {
      "Type": "String",
      "Default": "unset-code-bucket",
      "Description": "Bucket holding the three campaign Lambda artifacts (npm run build:campaign-engine)."
    },
    "ApiCodeKey": {
      "Type": "String",
      "Default": "campaigns/api.zip"
    },
    "SenderCodeKey": {
      "Type": "String",
      "Default": "campaigns/sender.zip"
    },
    "EventsCodeKey": {
      "Type": "String",
      "Default": "campaigns/events.zip"
    }
  },
  "Resources": {
    "CampaignKey": {
      "Type": "AWS::KMS::Key",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Description": "Campaign engine (commercial data): table, key secret, event topic, dead-letter queue and logs. No clinical resource uses it.",
        "EnableKeyRotation": true,
        "KeyPolicy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AccountAdministers",
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:root"
                }
              },
              "Action": "kms:*",
              "Resource": "*"
            },
            {
              "Sid": "SesPublishesEncryptedEvents",
              "Effect": "Allow",
              "Principal": {
                "Service": "ses.amazonaws.com"
              },
              "Action": [
                "kms:GenerateDataKey*",
                "kms:Decrypt"
              ],
              "Resource": "*",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                }
              }
            },
            {
              "Sid": "LogsUseKey",
              "Effect": "Allow",
              "Principal": {
                "Service": {
                  "Fn::Sub": "logs.${AWS::Region}.amazonaws.com"
                }
              },
              "Action": [
                "kms:Encrypt*",
                "kms:Decrypt*",
                "kms:ReEncrypt*",
                "kms:GenerateDataKey*",
                "kms:Describe*"
              ],
              "Resource": "*",
              "Condition": {
                "ArnLike": {
                  "kms:EncryptionContext:aws:logs:arn": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/alp/campaigns/*"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "CampaignKeyAlias": {
      "Type": "AWS::KMS::Alias",
      "Properties": {
        "AliasName": "alias/alp-campaigns",
        "TargetKeyId": {
          "Ref": "CampaignKey"
        }
      }
    },
    "CampaignTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": "alp-campaigns",
        "BillingMode": "PAY_PER_REQUEST",
        "DeletionProtectionEnabled": true,
        "AttributeDefinitions": [
          {
            "AttributeName": "PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "SK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "duePK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "dueAt",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "PK",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "SK",
            "KeyType": "RANGE"
          }
        ],
        "GlobalSecondaryIndexes": [
          {
            "IndexName": "due",
            "KeySchema": [
              {
                "AttributeName": "duePK",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "dueAt",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "ALL"
            }
          }
        ],
        "TimeToLiveSpecification": {
          "AttributeName": "ttl",
          "Enabled": true
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "SSESpecification": {
          "SSEEnabled": true,
          "SSEType": "KMS",
          "KMSMasterKeyId": {
            "Ref": "CampaignKey"
          }
        },
        "Tags": [
          {
            "Key": "alp-purpose",
            "Value": "marketing"
          },
          {
            "Key": "alp-data-class",
            "Value": "commercial"
          }
        ]
      }
    },
    "CampaignStaffRevocationTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": "alp-campaign-staff-revocations",
        "BillingMode": "PAY_PER_REQUEST",
        "DeletionProtectionEnabled": true,
        "AttributeDefinitions": [
          {
            "AttributeName": "subject",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "subject",
            "KeyType": "HASH"
          }
        ],
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "SSESpecification": {
          "SSEEnabled": true,
          "SSEType": "KMS"
        },
        "Tags": [
          {
            "Key": "alp-purpose",
            "Value": "marketing"
          },
          {
            "Key": "alp-data-class",
            "Value": "identifier"
          }
        ]
      }
    },
    "CampaignKeySecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "alp/campaigns/master-key",
        "Description": "Campaign token and address-hash master (SHA-256 of this value). Generated here; never copied.",
        "KmsKeyId": {
          "Ref": "CampaignKey"
        },
        "GenerateSecretString": {
          "PasswordLength": 64,
          "ExcludePunctuation": true
        }
      }
    },
    "CampaignEventsTopic": {
      "Type": "AWS::SNS::Topic",
      "Properties": {
        "TopicName": "alp-campaign-events",
        "KmsMasterKeyId": {
          "Ref": "CampaignKey"
        }
      }
    },
    "CampaignEventsTopicPolicy": {
      "Type": "AWS::SNS::TopicPolicy",
      "Properties": {
        "Topics": [
          {
            "Ref": "CampaignEventsTopic"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "SesPublishes",
              "Effect": "Allow",
              "Principal": {
                "Service": "ses.amazonaws.com"
              },
              "Action": "sns:Publish",
              "Resource": {
                "Ref": "CampaignEventsTopic"
              },
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "MarketingSet": {
      "Type": "AWS::SES::ConfigurationSet",
      "Properties": {
        "Name": "alp-marketing",
        "SuppressionOptions": {
          "SuppressedReasons": [
            "BOUNCE",
            "COMPLAINT"
          ]
        },
        "ReputationOptions": {
          "ReputationMetricsEnabled": true
        },
        "SendingOptions": {
          "SendingEnabled": true
        }
      }
    },
    "MarketingSetEvents": {
      "Type": "AWS::SES::ConfigurationSetEventDestination",
      "Properties": {
        "ConfigurationSetName": {
          "Ref": "MarketingSet"
        },
        "EventDestination": {
          "Name": "campaign-events",
          "Enabled": true,
          "MatchingEventTypes": [
            "BOUNCE",
            "COMPLAINT",
            "DELIVERY",
            "REJECT"
          ],
          "SnsDestination": {
            "TopicARN": {
              "Ref": "CampaignEventsTopic"
            }
          }
        }
      }
    },
    "MarketingTrackedSet": {
      "Type": "AWS::SES::ConfigurationSet",
      "Properties": {
        "Name": "alp-marketing-tracked",
        "SuppressionOptions": {
          "SuppressedReasons": [
            "BOUNCE",
            "COMPLAINT"
          ]
        },
        "ReputationOptions": {
          "ReputationMetricsEnabled": true
        },
        "SendingOptions": {
          "SendingEnabled": true
        }
      }
    },
    "MarketingTrackedSetEvents": {
      "Type": "AWS::SES::ConfigurationSetEventDestination",
      "Properties": {
        "ConfigurationSetName": {
          "Ref": "MarketingTrackedSet"
        },
        "EventDestination": {
          "Name": "campaign-events",
          "Enabled": true,
          "MatchingEventTypes": [
            "BOUNCE",
            "COMPLAINT",
            "DELIVERY",
            "REJECT",
            "OPEN",
            "CLICK"
          ],
          "SnsDestination": {
            "TopicARN": {
              "Ref": "CampaignEventsTopic"
            }
          }
        }
      }
    },
    "CampaignApiLogs": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "LogGroupName": "/alp/campaigns/api",
        "RetentionInDays": 90,
        "KmsKeyId": {
          "Fn::GetAtt": [
            "CampaignKey",
            "Arn"
          ]
        }
      }
    },
    "CampaignSenderLogs": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "LogGroupName": "/alp/campaigns/sender",
        "RetentionInDays": 90,
        "KmsKeyId": {
          "Fn::GetAtt": [
            "CampaignKey",
            "Arn"
          ]
        }
      }
    },
    "CampaignEventsLogs": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "LogGroupName": "/alp/campaigns/events",
        "RetentionInDays": 90,
        "KmsKeyId": {
          "Fn::GetAtt": [
            "CampaignKey",
            "Arn"
          ]
        }
      }
    },
    "CampaignApiAccessLogs": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "LogGroupName": "/alp/campaigns/api-access",
        "RetentionInDays": 90,
        "KmsKeyId": {
          "Fn::GetAtt": [
            "CampaignKey",
            "Arn"
          ]
        }
      }
    },
    "CampaignEventsDeadLetters": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "QueueName": "alp-campaign-events-dlq",
        "MessageRetentionPeriod": 1209600,
        "KmsMasterKeyId": {
          "Ref": "CampaignKey"
        }
      }
    },
    "CampaignApiRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "Logs",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "CampaignApiLogs",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          },
          {
            "PolicyName": "CampaignTable",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:DeleteItem",
                    "dynamodb:Query",
                    "dynamodb:ConditionCheckItem"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "CampaignTable",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::Sub": "${CampaignTable.Arn}/index/due"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "kms:Decrypt",
                    "kms:Encrypt",
                    "kms:GenerateDataKey"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "CampaignKey",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": {
                    "Ref": "CampaignKeySecret"
                  }
                }
              ]
            }
          },
          {
            "PolicyName": "MarketingSendOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "SendFromMarketingIdentities",
                  "Effect": "Allow",
                  "Action": "ses:SendEmail",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ses:${AWS::Region}:${AWS::AccountId}:identity/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "aws:ResourceTag/alp-purpose": "marketing"
                    }
                  }
                },
                {
                  "Sid": "ThroughMarketingSets",
                  "Effect": "Allow",
                  "Action": "ses:SendEmail",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ses:${AWS::Region}:${AWS::AccountId}:configuration-set/alp-marketing"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ses:${AWS::Region}:${AWS::AccountId}:configuration-set/alp-marketing-tracked"
                    }
                  ]
                },
                {
                  "Sid": "AsPracticeTenants",
                  "Effect": "Allow",
                  "Action": "ses:SendEmail",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ses:${AWS::Region}:${AWS::AccountId}:tenant/alp-practice-*"
                  }
                },
                {
                  "Sid": "NeverTransactional",
                  "Effect": "Deny",
                  "Action": "ses:*",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ses:${AWS::Region}:${AWS::AccountId}:configuration-set/alp-transactional"
                  }
                },
                {
                  "Sid": "SendingRate",
                  "Effect": "Allow",
                  "Action": "ses:GetAccount",
                  "Resource": "*"
                }
              ]
            }
          },
          {
            "PolicyName": "PracticeDomains",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "CreateMarketingIdentitiesAndTenants",
                  "Effect": "Allow",
                  "Action": [
                    "ses:CreateEmailIdentity",
                    "ses:CreateTenant",
                    "ses:TagResource"
                  ],
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestTag/alp-purpose": "marketing"
                    }
                  }
                },
                {
                  "Sid": "ManageMarketingIdentities",
                  "Effect": "Allow",
                  "Action": [
                    "ses:GetEmailIdentity",
                    "ses:PutEmailIdentityMailFromAttributes"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ses:${AWS::Region}:${AWS::AccountId}:identity/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "aws:ResourceTag/alp-purpose": "marketing"
                    }
                  }
                },
                {
                  "Sid": "AssociateWithPracticeTenants",
                  "Effect": "Allow",
                  "Action": "ses:CreateTenantResourceAssociation",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ses:${AWS::Region}:${AWS::AccountId}:tenant/alp-practice-*"
                  }
                },
                {
                  "Sid": "NeverTransactional",
                  "Effect": "Deny",
                  "Action": "ses:*",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ses:${AWS::Region}:${AWS::AccountId}:configuration-set/alp-transactional"
                  }
                }
              ]
            }
          },
          {
            "PolicyName": "StaffRevocationSignal",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "ReadStaffRevocationSignal",
                  "Effect": "Allow",
                  "Action": "dynamodb:GetItem",
                  "Resource": {
                    "Fn::GetAtt": [
                      "CampaignStaffRevocationTable",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "alp-purpose",
            "Value": "marketing"
          }
        ]
      }
    },
    "CampaignSenderRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
