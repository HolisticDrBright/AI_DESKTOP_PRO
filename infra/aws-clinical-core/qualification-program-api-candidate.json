{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "BLOCKED fictional-only qualification overlay for two program assignment routes; no production or PHI activation.",
  "Metadata": {
    "ClinicalCore": {
      "ContractVersion": "qualification-program-api-candidate/1",
      "Environment": "isolated-qualification",
      "DataClassification": "synthetic_only",
      "AccountId": "588966314750",
      "PhiAllowed": false,
      "Activation": "blocked",
      "SourceTemplate": "infra/aws-clinical-core/identity-api-extension.json"
    }
  },
  "Parameters": {
    "ClinicalApiId": {
      "Type": "String",
      "AllowedPattern": "^[a-z0-9]{10}$",
      "AllowedValues": [
        "6zt8e9qz04"
      ]
    },
    "WorkforceUserPoolId": {
      "Type": "String",
      "AllowedPattern": "^[a-z0-9-]+_[A-Za-z0-9]+$",
      "AllowedValues": [
        "us-east-2_ueGlFRbNB"
      ]
    },
    "WorkforceUserPoolClientId": {
      "Type": "String",
      "AllowedPattern": "^[A-Za-z0-9]{20,128}$",
      "AllowedValues": [
        "4s7jgr4o8sqdq7cvo9gmq96e2h"
      ]
    },
    "ConsumerUserPoolId": {
      "Type": "String",
      "AllowedPattern": "^[a-z0-9-]+_[A-Za-z0-9]+$",
      "AllowedValues": [
        "us-east-2_nYngyyYGE"
      ]
    },
    "ConsumerUserPoolClientId": {
      "Type": "String",
      "AllowedPattern": "^[A-Za-z0-9]{20,128}$",
      "AllowedValues": [
        "72aksm2dm4nf03l8d9nrp2dbh0"
      ]
    },
    "DatabaseClusterArn": {
      "Type": "String",
      "AllowedPattern": "^arn:(aws|aws-us-gov|aws-cn):rds:[a-z0-9-]+:[0-9]{12}:cluster:[A-Za-z0-9-]{1,63}$",
      "AllowedValues": [
        "arn:aws:rds:us-east-2:588966314750:cluster:ai-clinical-core-synthetic-clinicaldatabasecluster-lftvrccuflxa"
      ]
    },
    "DatabaseSecretArn": {
      "Type": "String",
      "NoEcho": true,
      "AllowedPattern": "^arn:aws:secretsmanager:us-east-2:588966314750:secret:rds!cluster-[A-Za-z0-9-]+$"
    },
    "DatabaseName": {
      "Type": "String",
      "AllowedPattern": "^[a-z][a-z0-9_]{0,62}$",
      "AllowedValues": [
        "clinical_core_qualification"
      ]
    },
    "ClinicalCoreKeyArn": {
      "Type": "String",
      "AllowedPattern": "^arn:(aws|aws-us-gov|aws-cn):kms:[a-z0-9-]+:[0-9]{12}:key/[0-9a-f-]{36}$",
      "AllowedValues": [
        "arn:aws:kms:us-east-2:588966314750:key/519c32c7-8dae-4722-9ab2-cd54e9a56611"
      ]
    },
    "LambdaCodeBucket": {
      "Type": "String",
      "AllowedPattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$",
      "AllowedValues": [
        "alp-qualification-code-588966314750-us-east-2"
      ]
    },
    "LambdaCodeKey": {
      "Type": "String",
      "AllowedPattern": "^[A-Za-z0-9!_.*'()/\\-]{1,1024}$"
    },
    "SourceCommit": {
      "Type": "String",
      "AllowedPattern": "^[0-9a-f]{40}$"
    },
    "AlarmTopicArn": {
      "Type": "String",
      "AllowedValues": [
        "arn:aws:sns:us-east-2:588966314750:ai-clinical-core-qualification-alarms"
      ]
    }
  },
  "Resources": {
    "IdentityApiLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${ClinicalApiId}-qualification-programs"
        },
        "RetentionInDays": 30,
        "KmsKeyId": {
          "Ref": "ClinicalCoreKeyArn"
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "IdentityApiRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "AuroraDataApiTransactionOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "rds-data:BeginTransaction",
                    "rds-data:ExecuteStatement",
                    "rds-data:CommitTransaction",
                    "rds-data:RollbackTransaction"
                  ],
                  "Resource": {
                    "Ref": "DatabaseClusterArn"
                  }
                }
              ]
            }
          },
          {
            "PolicyName": "ManagedDatabaseCredentialRead",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": {
                    "Ref": "DatabaseSecretArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "kms:Decrypt",
                  "Resource": {
                    "Ref": "ClinicalCoreKeyArn"
                  },
                  "Condition": {
                    "StringEquals": {
                      "kms:ViaService": {
                        "Fn::Sub": "secretsmanager.${AWS::Region}.${AWS::URLSuffix}"
                      }
                    }
                  }
                }
              ]
            }
          },
          {
            "PolicyName": "BoundedFunctionLogging",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "IdentityApiLogGroup",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "IdentityApiFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${ClinicalApiId}-qualification-programs"
        },
        "Runtime": "nodejs22.x",
        "Architectures": [
          "arm64"
        ],
        "Handler": "index.handler",
        "Role": {
          "Fn::GetAtt": [
            "IdentityApiRole",
            "Arn"
          ]
        },
        "MemorySize": 256,
        "Timeout": 29,
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "IdentityApiLogGroup"
          },
          "LogFormat": "JSON",
          "ApplicationLogLevel": "WARN",
          "SystemLogLevel": "WARN"
        },
        "Code": {
          "S3Bucket": {
            "Ref": "LambdaCodeBucket"
          },
          "S3Key": {
            "Ref": "LambdaCodeKey"
          }
        },
        "Environment": {
          "Variables": {
            "CLINICAL_DATABASE_CLUSTER_ARN": {
              "Ref": "DatabaseClusterArn"
            },
            "CLINICAL_DATABASE_SECRET_ARN": {
              "Ref": "DatabaseSecretArn"
            },
            "CLINICAL_DATABASE_NAME": {
              "Ref": "DatabaseName"
            },
            "CLINICAL_WORKFORCE_ISSUER": {
              "Fn::Sub": "https://cognito-idp.${AWS::Region}.${AWS::URLSuffix}/${WorkforceUserPoolId}"
            },
            "CLINICAL_WORKFORCE_AUDIENCE": {
              "Ref": "WorkforceUserPoolClientId"
            },
            "CLINICAL_CONSUMER_ISSUER": {
              "Fn::Sub": "https://cognito-idp.${AWS::Region}.${AWS::URLSuffix}/${ConsumerUserPoolId}"
            },
            "CLINICAL_CONSUMER_AUDIENCE": {
              "Ref": "ConsumerUserPoolClientId"
            },
            "DEPLOYMENT_ACCOUNT_ID": "588966314750",
            "PHI_ALLOWED": "false",
            "QUALIFICATION_EXECUTION": "programs",
            "SOURCE_COMMIT": {
              "Ref": "SourceCommit"
            }
          }
        }
      }
    },
    "WorkforceJwtAuthorizer": {
      "Type": "AWS::ApiGatewayV2::Authorizer",
      "Properties": {
        "ApiId": {
          "Ref": "ClinicalApiId"
        },
        "AuthorizerType": "JWT",
        "Name": "qualification-program-workforce",
        "IdentitySource": [
          "$request.header.Authorization"
        ],
        "JwtConfiguration": {
          "Issuer": {
            "Fn::Sub": "https://cognito-idp.${AWS::Region}.${AWS::URLSuffix}/${WorkforceUserPoolId}"
          },
          "Audience": [
            {
              "Ref": "WorkforceUserPoolClientId"
            }
          ]
        }
      }
    },
    "ConsumerJwtAuthorizer": {
      "Type": "AWS::ApiGatewayV2::Authorizer",
      "Properties": {
        "ApiId": {
          "Ref": "ClinicalApiId"
        },
        "AuthorizerType": "JWT",
        "Name": "qualification-program-consumer",
        "IdentitySource": [
          "$request.header.Authorization"
        ],
        "JwtConfiguration": {
          "Issuer": {
            "Fn::Sub": "https://cognito-idp.${AWS::Region}.${AWS::URLSuffix}/${ConsumerUserPoolId}"
          },
          "Audience": [
            {
              "Ref": "ConsumerUserPoolClientId"
            }
          ]
        }
      }
    },
    "IdentityApiIntegration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "ClinicalApiId"
        },
        "IntegrationType": "AWS_PROXY",
        "IntegrationUri": {
          "Fn::GetAtt": [
            "IdentityApiFunction",
            "Arn"
          ]
        },
        "PayloadFormatVersion": "2.0",
        "TimeoutInMillis": 30000
      }
    },
    "ConsumerProgramAssignmentsRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "ClinicalApiId"
        },
        "RouteKey": "POST /clinical-core/consumer/programs",
        "AuthorizationType": "JWT",
        "AuthorizerId": {
          "Ref": "ConsumerJwtAuthorizer"
        },
        "Target": {
          "Fn::Sub": "integrations/${IdentityApiIntegration}"
        }
      }
    },
    "WorkforceProgramAssignmentsRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "ClinicalApiId"
        },
        "RouteKey": "POST /clinical-core/workforce/programs",
        "AuthorizationType": "JWT",
        "AuthorizerId": {
          "Ref": "WorkforceJwtAuthorizer"
        },
        "Target": {
          "Fn::Sub": "integrations/${IdentityApiIntegration}"
        }
      }
    },
    "IdentityApiErrorAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Fictional qualification program API Lambda errors",
        "Namespace": "AWS/Lambda",
        "MetricName": "Errors",
        "Dimensions": [
          {
            "Name": "FunctionName",
            "Value": {
              "Ref": "IdentityApiFunction"
            }
          }
        ],
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmName": "ai-clinical-core-qualification-program-api-errors",
        "AlarmActions": [
          {
            "Ref": "AlarmTopicArn"
          }
        ]
      }
    },
    "ConsumerProgramInvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "IdentityApiFunction"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${ClinicalApiId}/*/POST/clinical-core/consumer/programs"
        }
      }
    },
    "WorkforceProgramInvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "IdentityApiFunction"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${ClinicalApiId}/*/POST/clinical-core/workforce/programs"
        }
      }
    }
  },
  "Outputs": {
    "FunctionArn": {
      "Value": {
        "Fn::GetAtt": [
          "IdentityApiFunction",
          "Arn"
        ]
      }
    },
    "QualificationExecution": {
      "Value": "programs_fictional_only"
    },
    "PhiAllowed": {
      "Value": "false"
    }
  }
}
