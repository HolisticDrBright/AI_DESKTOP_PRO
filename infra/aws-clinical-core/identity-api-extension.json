{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Authenticated synthetic-only identity and consent API extension for AI Desktop Pro.",
  "Metadata": {
    "ClinicalCore": {
      "ContractVersion": "clinical-core-authenticated-api/1",
      "Environment": "synthetic-staging",
      "DataClassification": "synthetic_only",
      "ContainsPhi": false,
      "RealPatientDataAllowed": false
    }
  },
  "Parameters": {
    "ClinicalApiId": { "Type": "String", "AllowedPattern": "^[a-z0-9]{10}$" },
    "WorkforceUserPoolId": { "Type": "String", "AllowedPattern": "^[a-z0-9-]+_[A-Za-z0-9]+$" },
    "WorkforceUserPoolClientId": { "Type": "String", "AllowedPattern": "^[A-Za-z0-9]{20,128}$" },
    "ConsumerUserPoolId": { "Type": "String", "AllowedPattern": "^[a-z0-9-]+_[A-Za-z0-9]+$" },
    "ConsumerUserPoolClientId": { "Type": "String", "AllowedPattern": "^[A-Za-z0-9]{20,128}$" },
    "DatabaseClusterArn": { "Type": "String", "AllowedPattern": "^arn:(aws|aws-us-gov|aws-cn):rds:[a-z0-9-]+:[0-9]{12}:cluster:[A-Za-z0-9-]{1,63}$" },
    "DatabaseSecretArn": { "Type": "String", "NoEcho": true },
    "DatabaseName": { "Type": "String", "AllowedPattern": "^[a-z][a-z0-9_]{0,62}$" },
    "ClinicalCoreKeyArn": { "Type": "String", "AllowedPattern": "^arn:(aws|aws-us-gov|aws-cn):kms:[a-z0-9-]+:[0-9]{12}:key/[0-9a-f-]{36}$" },
    "LambdaCodeBucket": { "Type": "String", "AllowedPattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$" },
    "LambdaCodeKey": { "Type": "String", "AllowedPattern": "^[A-Za-z0-9!_.*'()/\\-]{1,1024}$" }
  },
  "Resources": {
    "IdentityApiLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/ai-clinical-core/synthetic-staging/identity-api",
        "RetentionInDays": 30,
        "KmsKeyId": { "Ref": "ClinicalCoreKeyArn" }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "IdentityApiRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [{
            "Effect": "Allow",
            "Principal": { "Service": "lambda.amazonaws.com" },
            "Action": "sts:AssumeRole"
          }]
        },
        "Policies": [
          {
            "PolicyName": "AuroraDataApiTransactionOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [{
                "Effect": "Allow",
                "Action": [
                  "rds-data:BeginTransaction",
                  "rds-data:ExecuteStatement",
                  "rds-data:CommitTransaction",
                  "rds-data:RollbackTransaction"
                ],
                "Resource": { "Ref": "DatabaseClusterArn" }
              }]
            }
          },
          {
            "PolicyName": "ManagedDatabaseCredentialRead",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": { "Ref": "DatabaseSecretArn" }
                },
                {
                  "Effect": "Allow",
                  "Action": "kms:Decrypt",
                  "Resource": { "Ref": "ClinicalCoreKeyArn" },
                  "Condition": {
                    "StringEquals": { "kms:ViaService": { "Fn::Sub": "secretsmanager.${AWS::Region}.${AWS::URLSuffix}" } }
                  }
                }
              ]
            }
          },
          {
            "PolicyName": "BoundedFunctionLogging",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [{
                "Effect": "Allow",
                "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
                "Resource": { "Fn::GetAtt": ["IdentityApiLogGroup", "Arn"] }
              }]
            }
          }
        ]
      }
    },
    "IdentityApiFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": { "Fn::Sub": "${ClinicalApiId}-synthetic-identity" },
        "Runtime": "nodejs22.x",
        "Architectures": ["arm64"],
        "Handler": "index.handler",
        "Role": { "Fn::GetAtt": ["IdentityApiRole", "Arn"] },
        "MemorySize": 256,
        "Timeout": 15,
        "LoggingConfig": {
          "LogGroup": { "Ref": "IdentityApiLogGroup" },
          "LogFormat": "JSON",
          "ApplicationLogLevel": "WARN",
          "SystemLogLevel": "WARN"
        },
        "Code": { "S3Bucket": { "Ref": "LambdaCodeBucket" }, "S3Key": { "Ref": "LambdaCodeKey" } },
        "Environment": {
          "Variables": {
            "CLINICAL_DATABASE_CLUSTER_ARN": { "Ref": "DatabaseClusterArn" },
            "CLINICAL_DATABASE_SECRET_ARN": { "Ref": "DatabaseSecretArn" },
            "CLINICAL_DATABASE_NAME": { "Ref": "DatabaseName" },
            "CLINICAL_WORKFORCE_ISSUER": { "Fn::Sub": "https://cognito-idp.${AWS::Region}.${AWS::URLSuffix}/${WorkforceUserPoolId}" },
            "CLINICAL_WORKFORCE_AUDIENCE": { "Ref": "WorkforceUserPoolClientId" },
            "CLINICAL_CONSUMER_ISSUER": { "Fn::Sub": "https://cognito-idp.${AWS::Region}.${AWS::URLSuffix}/${ConsumerUserPoolId}" },
            "CLINICAL_CONSUMER_AUDIENCE": { "Ref": "ConsumerUserPoolClientId" }
          }
        }
      }
    },
    "WorkforceJwtAuthorizer": {
      "Type": "AWS::ApiGatewayV2::Authorizer",
      "Properties": {
        "ApiId": { "Ref": "ClinicalApiId" },
        "AuthorizerType": "JWT",
        "Name": "synthetic-workforce",
        "IdentitySource": ["$request.header.Authorization"],
        "JwtConfiguration": {
          "Issuer": { "Fn::Sub": "https://cognito-idp.${AWS::Region}.${AWS::URLSuffix}/${WorkforceUserPoolId}" },
          "Audience": [{ "Ref": "WorkforceUserPoolClientId" }]
        }
      }
    },
    "ConsumerJwtAuthorizer": {
      "Type": "AWS::ApiGatewayV2::Authorizer",
      "Properties": {
        "ApiId": { "Ref": "ClinicalApiId" },
        "AuthorizerType": "JWT",
        "Name": "synthetic-consumer",
        "IdentitySource": ["$request.header.Authorization"],
        "JwtConfiguration": {
          "Issuer": { "Fn::Sub": "https://cognito-idp.${AWS::Region}.${AWS::URLSuffix}/${ConsumerUserPoolId}" },
          "Audience": [{ "Ref": "ConsumerUserPoolClientId" }]
        }
      }
    },
    "IdentityApiIntegration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": { "Ref": "ClinicalApiId" },
        "IntegrationType": "AWS_PROXY",
        "IntegrationUri": { "Fn::GetAtt": ["IdentityApiFunction", "Arn"] },
        "PayloadFormatVersion": "2.0",
        "TimeoutInMillis": 15000
      }
    },
    "WorkforcePostureRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": { "Ref": "ClinicalApiId" }, "RouteKey": "GET /clinical-core/workforce/posture",
        "AuthorizationType": "JWT", "AuthorizerId": { "Ref": "WorkforceJwtAuthorizer" },
        "Target": { "Fn::Sub": "integrations/${IdentityApiIntegration}" }
      }
    },
    "ConsumerPostureRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": { "Ref": "ClinicalApiId" }, "RouteKey": "GET /clinical-core/consumer/posture",
        "AuthorizationType": "JWT", "AuthorizerId": { "Ref": "ConsumerJwtAuthorizer" },
        "Target": { "Fn::Sub": "integrations/${IdentityApiIntegration}" }
      }
    },
    "IssueInvitationRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": { "Ref": "ClinicalApiId" }, "RouteKey": "POST /clinical-core/workforce/invitations",
        "AuthorizationType": "JWT", "AuthorizerId": { "Ref": "WorkforceJwtAuthorizer" },
        "Target": { "Fn::Sub": "integrations/${IdentityApiIntegration}" }
      }
    },
    "ClaimInvitationRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": { "Ref": "ClinicalApiId" }, "RouteKey": "POST /clinical-core/consumer/invitations/claim",
        "AuthorizationType": "JWT", "AuthorizerId": { "Ref": "ConsumerJwtAuthorizer" },
        "Target": { "Fn::Sub": "integrations/${IdentityApiIntegration}" }
      }
    },
    "WorkforceGrantConsentRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": { "Ref": "ClinicalApiId" }, "RouteKey": "POST /clinical-core/workforce/consents/grant",
        "AuthorizationType": "JWT", "AuthorizerId": { "Ref": "WorkforceJwtAuthorizer" },
        "Target": { "Fn::Sub": "integrations/${IdentityApiIntegration}" }
      }
    },
    "ConsumerGrantConsentRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": { "Ref": "ClinicalApiId" }, "RouteKey": "POST /clinical-core/consumer/consents/grant",
        "AuthorizationType": "JWT", "AuthorizerId": { "Ref": "ConsumerJwtAuthorizer" },
        "Target": { "Fn::Sub": "integrations/${IdentityApiIntegration}" }
      }
    },
    "WorkforceRevokeConsentRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": { "Ref": "ClinicalApiId" }, "RouteKey": "POST /clinical-core/workforce/consents/revoke",
        "AuthorizationType": "JWT", "AuthorizerId": { "Ref": "WorkforceJwtAuthorizer" },
        "Target": { "Fn::Sub": "integrations/${IdentityApiIntegration}" }
      }
    },
    "ConsumerRevokeConsentRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": { "Ref": "ClinicalApiId" }, "RouteKey": "POST /clinical-core/consumer/consents/revoke",
        "AuthorizationType": "JWT", "AuthorizerId": { "Ref": "ConsumerJwtAuthorizer" },
        "Target": { "Fn::Sub": "integrations/${IdentityApiIntegration}" }
      }
    },
    "ConsumerLabImportRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": { "Ref": "ClinicalApiId" }, "RouteKey": "POST /clinical-core/consumer/labs/import",
        "AuthorizationType": "JWT", "AuthorizerId": { "Ref": "ConsumerJwtAuthorizer" },
        "Target": { "Fn::Sub": "integrations/${IdentityApiIntegration}" }
      }
    },
    "ConsumerConnectionRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": { "Ref": "ClinicalApiId" }, "RouteKey": "GET /clinical-core/consumer/connection",
        "AuthorizationType": "JWT", "AuthorizerId": { "Ref": "ConsumerJwtAuthorizer" },
        "Target": { "Fn::Sub": "integrations/${IdentityApiIntegration}" }
      }
    },
    "WorkforceLabImportListRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": { "Ref": "ClinicalApiId" }, "RouteKey": "GET /clinical-core/workforce/lab-imports",
        "AuthorizationType": "JWT", "AuthorizerId": { "Ref": "WorkforceJwtAuthorizer" },
        "Target": { "Fn::Sub": "integrations/${IdentityApiIntegration}" }
      }
    },
    "WorkforceLabImportReviewRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": { "Ref": "ClinicalApiId" }, "RouteKey": "POST /clinical-core/workforce/lab-imports/review",
        "AuthorizationType": "JWT", "AuthorizerId": { "Ref": "WorkforceJwtAuthorizer" },
        "Target": { "Fn::Sub": "integrations/${IdentityApiIntegration}" }
      }
    },
    "WorkforcePatientLabsRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": { "Ref": "ClinicalApiId" }, "RouteKey": "GET /clinical-core/workforce/patient-labs",
        "AuthorizationType": "JWT", "AuthorizerId": { "Ref": "WorkforceJwtAuthorizer" },
        "Target": { "Fn::Sub": "integrations/${IdentityApiIntegration}" }
      }
    },
    "ConsumerPatientLabsRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": { "Ref": "ClinicalApiId" }, "RouteKey": "GET /clinical-core/consumer/patient-labs",
        "AuthorizationType": "JWT", "AuthorizerId": { "Ref": "ConsumerJwtAuthorizer" },
        "Target": { "Fn::Sub": "integrations/${IdentityApiIntegration}" }
      }
    },
    "IdentityApiInvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": { "Ref": "IdentityApiFunction" },
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": { "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${ClinicalApiId}/*/*/clinical-core/*" }
      }
    },
    "IdentityApiErrorAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Authenticated synthetic API Lambda errors",
        "Namespace": "AWS/Lambda",
        "MetricName": "Errors",
        "Dimensions": [{ "Name": "FunctionName", "Value": { "Ref": "IdentityApiFunction" } }],
        "Statistic": "Sum", "Period": 300, "EvaluationPeriods": 1, "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold", "TreatMissingData": "notBreaching"
      }
    }
  },
  "Outputs": {
    "ContractVersion": { "Value": "clinical-core-authenticated-api/1" },
    "IdentityApiFunctionArn": { "Value": { "Fn::GetAtt": ["IdentityApiFunction", "Arn"] } },
    "RoutesEnabled": { "Value": "14" },
    "PhiAllowed": { "Value": "false" }
  }
}
