{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Governed consumer registration and recovery API. No clinical payloads are accepted.",
  "Metadata": { "ClinicalCore": { "ContractVersion": "consumer-account/1", "ContainsPhi": false } },
  "Parameters": {
    "EnvironmentName": { "Type": "String", "AllowedValues": ["synthetic-staging", "production-clinical"] },
    "Boundary": { "Type": "String", "AllowedValues": ["synthetic", "production"] },
    "ClinicalApiId": { "Type": "String", "AllowedPattern": "^[a-z0-9]{10}$" },
    "ConsumerUserPoolId": { "Type": "String", "AllowedPattern": "^[a-z0-9-]+_[A-Za-z0-9]+$" },
    "ConsumerUserPoolClientId": { "Type": "String", "AllowedPattern": "^[A-Za-z0-9]{20,128}$" },
    "DatabaseClusterArn": { "Type": "String", "AllowedPattern": "^arn:(aws|aws-us-gov|aws-cn):rds:[a-z0-9-]+:[0-9]{12}:cluster:[A-Za-z0-9-]{1,63}$" },
    "DatabaseSecretArn": { "Type": "String", "NoEcho": true },
    "DatabaseName": { "Type": "String", "AllowedPattern": "^[a-z][a-z0-9_]{0,62}$" },
    "ClinicalCoreKeyArn": { "Type": "String", "AllowedPattern": "^arn:(aws|aws-us-gov|aws-cn):kms:[a-z0-9-]+:[0-9]{12}:key/[0-9a-f-]{36}$" },
    "LambdaCodeBucket": { "Type": "String", "AllowedPattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$" },
    "LambdaCodeKey": { "Type": "String", "AllowedPattern": "^[A-Za-z0-9!_.*'()/\\-]{1,1024}$" },
    "TermsVersion": { "Type": "String", "Default": "terms-2026-08", "AllowedPattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "PrivacyVersion": { "Type": "String", "Default": "privacy-2026-08", "AllowedPattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" }
  },
  "Resources": {
    "ConsumerRegistrationClient": {
      "Type": "AWS::Cognito::UserPoolClient",
      "Properties": {
        "ClientName": { "Fn::Sub": "${EnvironmentName}-governed-registration" },
        "UserPoolId": { "Ref": "ConsumerUserPoolId" },
        "GenerateSecret": true,
        "PreventUserExistenceErrors": "ENABLED",
        "EnableTokenRevocation": true,
        "ExplicitAuthFlows": ["ALLOW_REFRESH_TOKEN_AUTH"],
        "ReadAttributes": ["email", "email_verified", "custom:person_id", "custom:organization_id", "custom:synthetic_attested", "custom:production_bound"],
        "WriteAttributes": ["email", "custom:person_id", "custom:organization_id", "custom:synthetic_attested", "custom:production_bound"]
      }
    },
    "ConsumerAccountLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": { "LogGroupName": { "Fn::Sub": "/ai-clinical-core/${EnvironmentName}/consumer-account" }, "RetentionInDays": 30, "KmsKeyId": { "Ref": "ClinicalCoreKeyArn" } },
      "DeletionPolicy": "Retain", "UpdateReplacePolicy": "Retain"
    },
    "ConsumerAccountRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Principal": { "Service": "lambda.amazonaws.com" }, "Action": "sts:AssumeRole" }] },
        "Policies": [
          { "PolicyName": "RegistrationBootstrapDatabase", "PolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": ["rds-data:BeginTransaction", "rds-data:ExecuteStatement", "rds-data:CommitTransaction", "rds-data:RollbackTransaction"], "Resource": { "Ref": "DatabaseClusterArn" } }] } },
          { "PolicyName": "RegistrationBootstrapCredential", "PolicyDocument": { "Version": "2012-10-17", "Statement": [
            { "Effect": "Allow", "Action": "secretsmanager:GetSecretValue", "Resource": { "Ref": "DatabaseSecretArn" } },
            { "Effect": "Allow", "Action": "kms:Decrypt", "Resource": { "Ref": "ClinicalCoreKeyArn" }, "Condition": { "StringEquals": { "kms:ViaService": { "Fn::Sub": "secretsmanager.${AWS::Region}.${AWS::URLSuffix}" } } } }
          ] } },
          { "PolicyName": "ConfirmedUserLookupOnly", "PolicyDocument": { "Version": "2012-10-17", "Statement": [
            { "Effect": "Allow", "Action": "cognito-idp:AdminGetUser", "Resource": { "Fn::Sub": "arn:${AWS::Partition}:cognito-idp:${AWS::Region}:${AWS::AccountId}:userpool/${ConsumerUserPoolId}" } },
            { "Effect": "Allow", "Action": "cognito-idp:DescribeUserPoolClient", "Resource": "*" }
          ] } },
          { "PolicyName": "BoundedRegistrationLogging", "PolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": ["logs:CreateLogStream", "logs:PutLogEvents"], "Resource": { "Fn::GetAtt": ["ConsumerAccountLogGroup", "Arn"] } }] } }
        ]
      }
    },
    "ConsumerAccountFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": { "Fn::Sub": "${ClinicalApiId}-${Boundary}-consumer-account" },
        "Runtime": "nodejs22.x", "Architectures": ["arm64"], "Handler": "index.handler",
        "Role": { "Fn::GetAtt": ["ConsumerAccountRole", "Arn"] }, "MemorySize": 256, "Timeout": 15,
        "LoggingConfig": { "LogGroup": { "Ref": "ConsumerAccountLogGroup" }, "LogFormat": "JSON", "ApplicationLogLevel": "WARN", "SystemLogLevel": "WARN" },
        "Code": { "S3Bucket": { "Ref": "LambdaCodeBucket" }, "S3Key": { "Ref": "LambdaCodeKey" } },
        "Environment": { "Variables": {
          "CONSUMER_USER_POOL_ID": { "Ref": "ConsumerUserPoolId" }, "CONSUMER_USER_POOL_CLIENT_ID": { "Ref": "ConsumerRegistrationClient" },
          "CONSUMER_ACCOUNT_BOUNDARY": { "Ref": "Boundary" }, "CONSUMER_TERMS_VERSION": { "Ref": "TermsVersion" }, "CONSUMER_PRIVACY_VERSION": { "Ref": "PrivacyVersion" },
          "CLINICAL_DATABASE_CLUSTER_ARN": { "Ref": "DatabaseClusterArn" }, "CLINICAL_DATABASE_SECRET_ARN": { "Ref": "DatabaseSecretArn" }, "CLINICAL_DATABASE_NAME": { "Ref": "DatabaseName" }
        } }
      }
    },
    "ConsumerAccountIntegration": { "Type": "AWS::ApiGatewayV2::Integration", "Properties": { "ApiId": { "Ref": "ClinicalApiId" }, "IntegrationType": "AWS_PROXY", "IntegrationUri": { "Fn::GetAtt": ["ConsumerAccountFunction", "Arn"] }, "PayloadFormatVersion": "2.0", "TimeoutInMillis": 15000 } },
    "RegisterRoute": { "Type": "AWS::ApiGatewayV2::Route", "Properties": { "ApiId": { "Ref": "ClinicalApiId" }, "RouteKey": "POST /clinical-core/public/consumer/register", "AuthorizationType": "NONE", "Target": { "Fn::Sub": "integrations/${ConsumerAccountIntegration}" } } },
    "ConfirmRoute": { "Type": "AWS::ApiGatewayV2::Route", "Properties": { "ApiId": { "Ref": "ClinicalApiId" }, "RouteKey": "POST /clinical-core/public/consumer/registration/confirm", "AuthorizationType": "NONE", "Target": { "Fn::Sub": "integrations/${ConsumerAccountIntegration}" } } },
    "ResendRoute": { "Type": "AWS::ApiGatewayV2::Route", "Properties": { "ApiId": { "Ref": "ClinicalApiId" }, "RouteKey": "POST /clinical-core/public/consumer/registration/resend", "AuthorizationType": "NONE", "Target": { "Fn::Sub": "integrations/${ConsumerAccountIntegration}" } } },
    "RecoveryRequestRoute": { "Type": "AWS::ApiGatewayV2::Route", "Properties": { "ApiId": { "Ref": "ClinicalApiId" }, "RouteKey": "POST /clinical-core/public/consumer/recovery/request", "AuthorizationType": "NONE", "Target": { "Fn::Sub": "integrations/${ConsumerAccountIntegration}" } } },
    "RecoveryConfirmRoute": { "Type": "AWS::ApiGatewayV2::Route", "Properties": { "ApiId": { "Ref": "ClinicalApiId" }, "RouteKey": "POST /clinical-core/public/consumer/recovery/confirm", "AuthorizationType": "NONE", "Target": { "Fn::Sub": "integrations/${ConsumerAccountIntegration}" } } },
    "InvokePermission": { "Type": "AWS::Lambda::Permission", "Properties": { "Action": "lambda:InvokeFunction", "FunctionName": { "Ref": "ConsumerAccountFunction" }, "Principal": "apigateway.amazonaws.com", "SourceArn": { "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${ClinicalApiId}/*/POST/clinical-core/public/consumer/*" } } },
    "ErrorAlarm": { "Type": "AWS::CloudWatch::Alarm", "Properties": { "Namespace": "AWS/Lambda", "MetricName": "Errors", "Dimensions": [{ "Name": "FunctionName", "Value": { "Ref": "ConsumerAccountFunction" } }], "Statistic": "Sum", "Period": 300, "EvaluationPeriods": 1, "Threshold": 1, "ComparisonOperator": "GreaterThanOrEqualToThreshold", "TreatMissingData": "notBreaching" } }
  },
  "Outputs": {
    "ContractVersion": { "Value": "consumer-account/1" }, "FunctionName": { "Value": { "Ref": "ConsumerAccountFunction" } },
    "ContainsPhi": { "Value": "false" }, "Boundary": { "Value": { "Ref": "Boundary" } }
  }
}
