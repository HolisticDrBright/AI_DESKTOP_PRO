{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Durable synthetic-only AWS lab analysis for AI Longevity Pro V2.",
  "Metadata": {
    "ClinicalCore": {
      "ContractVersion": "lab-analysis/1",
      "Environment": "synthetic-staging",
      "DataClassification": "synthetic_only",
      "ContainsPhi": false,
      "RealPatientDataAllowed": false
    }
  },
  "Parameters": {
    "LabCleanupAlarmTopicArn": {"Type":"String","Default":"","AllowedPattern":"^$|^arn:aws:sns:[a-z0-9-]+:[0-9]{12}:[A-Za-z0-9_-]+$"},
    "KnowledgeReleaseMode": {"Type":"String","Default":"disabled","AllowedValues":["disabled","reviewed_release"]},
    "KnowledgeReleaseBucket": {"Type":"String","Default":"","AllowedPattern":"^$|^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"},
    "KnowledgeReleaseKey": {"Type":"String","Default":"","AllowedPattern":"^$|^reviewed-knowledge/[A-Za-z0-9_./-]+\\.json$"},
    "KnowledgeReleaseObjectVersion": {"Type":"String","Default":"","MaxLength":1024},
    "KnowledgeReleaseSha256": {"Type":"String","Default":"","AllowedPattern":"^$|^[a-f0-9]{64}$"},
    "KnowledgeSourcePackageSha256": {"Type":"String","Default":"","AllowedPattern":"^$|^[a-f0-9]{64}$"},
    "KnowledgeSignerPublicKeyPem": {"Type":"String","Default":"","MaxLength":512},
    "LabRangeMode": { "Type": "String", "Default": "synthetic_fixture", "AllowedValues": ["synthetic_fixture", "reviewed_release"] },
    "LabRangeReleaseBucket": { "Type": "String", "Default": "", "AllowedPattern": "^$|^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$" },
    "LabRangeReleaseKey": { "Type": "String", "Default": "", "AllowedPattern": "^$|^reviewed-lab-ranges/[A-Za-z0-9_./-]+\\.json$" },
    "LabRangeReleaseSha256": { "Type": "String", "Default": "", "AllowedPattern": "^$|^[a-f0-9]{64}$" },
    "LabRangeSignerPublicKeyPem": { "Type": "String", "Default": "", "MaxLength": 512 },
    "ClinicalApiId": { "Type": "String", "AllowedPattern": "^[a-z0-9]{10}$" },
    "ConsumerUserPoolId": { "Type": "String", "AllowedPattern": "^[a-z0-9-]+_[A-Za-z0-9]+$" },
    "ConsumerUserPoolClientId": { "Type": "String", "AllowedPattern": "^[A-Za-z0-9]{20,128}$" },
    "SyntheticSupabaseIssuer": { "Type": "String", "AllowedPattern": "^https://[a-z0-9-]+\\.supabase\\.co/auth/v1$" },
    "SyntheticSupabaseAudience": { "Type": "String", "Default": "authenticated", "AllowedValues": ["authenticated"] },
    "SyntheticEmailDomain": { "Type": "String", "Default": "@brightlongevity.test", "AllowedPattern": "^@[a-z0-9.-]+$" },
    "SyntheticOrganizationId": { "Type": "String", "Default": "11111111-1111-4111-8111-111111111111", "AllowedPattern": "^[0-9a-f-]{36}$" },
    "SyntheticAllowedSubjects": { "Type": "String", "AllowedPattern": "^[0-9a-f-]{36}(,[0-9a-f-]{36}){0,9}$" },
    "ClinicalCoreKeyArn": { "Type": "String", "AllowedPattern": "^arn:(aws|aws-us-gov|aws-cn):kms:[a-z0-9-]+:[0-9]{12}:key/[0-9a-f-]{36}$" },
    "LambdaCodeBucket": { "Type": "String", "AllowedPattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$" },
    "ApiCodeKey": { "Type": "String", "AllowedPattern": "^[A-Za-z0-9!_.*'()/\\-]{1,1024}$" },
    "WorkerCodeKey": { "Type": "String", "AllowedPattern": "^[A-Za-z0-9!_.*'()/\\-]{1,1024}$" },
    "OpenAISecretArn": { "Type": "String", "AllowedPattern": "^arn:(aws|aws-us-gov|aws-cn):secretsmanager:[a-z0-9-]+:[0-9]{12}:secret:[A-Za-z0-9/_+=.@-]+$" },
    "OpenAIModel": { "Type": "String", "Default": "gpt-5.1-2025-11-13", "AllowedValues": ["gpt-5.1-2025-11-13"] }
  },
  "Rules": {
    "ReviewedKnowledgeMaterial": {"RuleCondition":{"Fn::Equals":[{"Ref":"KnowledgeReleaseMode"},"reviewed_release"]},"Assertions":[{"Assert":{"Fn::Not":[{"Fn::Equals":[{"Ref":"KnowledgeReleaseBucket"},""]}]},"AssertDescription":"KnowledgeReleaseBucket is required for reviewed knowledge."},{"Assert":{"Fn::Not":[{"Fn::Equals":[{"Ref":"KnowledgeReleaseKey"},""]}]},"AssertDescription":"KnowledgeReleaseKey is required for reviewed knowledge."},{"Assert":{"Fn::Not":[{"Fn::Equals":[{"Ref":"KnowledgeReleaseObjectVersion"},""]}]},"AssertDescription":"KnowledgeReleaseObjectVersion is required for reviewed knowledge."},{"Assert":{"Fn::Not":[{"Fn::Equals":[{"Ref":"KnowledgeReleaseSha256"},""]}]},"AssertDescription":"KnowledgeReleaseSha256 is required for reviewed knowledge."},{"Assert":{"Fn::Not":[{"Fn::Equals":[{"Ref":"KnowledgeSourcePackageSha256"},""]}]},"AssertDescription":"KnowledgeSourcePackageSha256 is required for reviewed knowledge."},{"Assert":{"Fn::Not":[{"Fn::Equals":[{"Ref":"KnowledgeSignerPublicKeyPem"},""]}]},"AssertDescription":"KnowledgeSignerPublicKeyPem is required for reviewed knowledge."}]},
    "ReviewedRangeMaterial": { "RuleCondition": { "Fn::Equals": [{ "Ref": "LabRangeMode" }, "reviewed_release"] }, "Assertions": [
      { "Assert": { "Fn::Not": [{ "Fn::Equals": [{ "Ref": "LabRangeReleaseBucket" }, ""] }] }, "AssertDescription": "Reviewed range bucket is required." },
      { "Assert": { "Fn::Not": [{ "Fn::Equals": [{ "Ref": "LabRangeReleaseKey" }, ""] }] }, "AssertDescription": "Reviewed range object is required." },
      { "Assert": { "Fn::Not": [{ "Fn::Equals": [{ "Ref": "LabRangeReleaseSha256" }, ""] }] }, "AssertDescription": "Reviewed range hash is required." },
      { "Assert": { "Fn::Not": [{ "Fn::Equals": [{ "Ref": "LabRangeSignerPublicKeyPem" }, ""] }] }, "AssertDescription": "Reviewed range public signing key is required." }
    ] }
  },
  "Conditions": {"HasCleanupAlarmTopic":{"Fn::Not":[{"Fn::Equals":[{"Ref":"LabCleanupAlarmTopicArn"},""]}]},"ReviewedRanges":{"Fn::Equals":[{"Ref":"LabRangeMode"},"reviewed_release"]},"ReviewedKnowledge":{"Fn::Equals":[{"Ref":"KnowledgeReleaseMode"},"reviewed_release"]}},
  "Resources": {
    "LabJobTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Delete",
      "UpdateReplacePolicy": "Delete",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [{ "AttributeName": "pk", "AttributeType": "S" }, { "AttributeName": "inventoryOwner", "AttributeType": "S" }, { "AttributeName": "inventoryOrder", "AttributeType": "S" }, {"AttributeName":"cleanupPartition","AttributeType":"S"}, {"AttributeName":"cleanupDue","AttributeType":"S"}],
        "KeySchema": [{ "AttributeName": "pk", "KeyType": "HASH" }],
        "GlobalSecondaryIndexes": [{ "IndexName": "LabOwnerInventory", "KeySchema": [{ "AttributeName": "inventoryOwner", "KeyType": "HASH" }, { "AttributeName": "inventoryOrder", "KeyType": "RANGE" }], "Projection": { "ProjectionType": "KEYS_ONLY" } }, {"IndexName":"LabCleanupDue","KeySchema":[{"AttributeName":"cleanupPartition","KeyType":"HASH"},{"AttributeName":"cleanupDue","KeyType":"RANGE"}],"Projection":{"ProjectionType":"KEYS_ONLY"}}],
        "PointInTimeRecoverySpecification": { "PointInTimeRecoveryEnabled": true },
        "SSESpecification": { "SSEEnabled": true, "SSEType": "KMS", "KMSMasterKeyId": { "Ref": "ClinicalCoreKeyArn" } },
        "TimeToLiveSpecification": { "AttributeName": "expiresAt", "Enabled": true },
        "Tags": [
          { "Key": "Environment", "Value": "synthetic-staging" },
          { "Key": "DataClassification", "Value": "synthetic_only" }
        ]
      }
    },
    "LabDocumentsBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Delete",
      "UpdateReplacePolicy": "Delete",
      "Properties": {
        "NotificationConfiguration": {"EventBridgeConfiguration":{"EventBridgeEnabled":true}},
        "BucketEncryption": { "ServerSideEncryptionConfiguration": [{ "BucketKeyEnabled": true, "ServerSideEncryptionByDefault": { "KMSMasterKeyID": { "Ref": "ClinicalCoreKeyArn" }, "SSEAlgorithm": "aws:kms" } }] },
        "CorsConfiguration": { "CorsRules": [{ "AllowedHeaders": ["*"], "AllowedMethods": ["PUT"], "AllowedOrigins": ["http://localhost:8081", "http://127.0.0.1:8081", "http://localhost:19006", "http://127.0.0.1:19006"], "ExposedHeaders": ["ETag"], "MaxAge": 300 }] },
        "LifecycleConfiguration": { "Rules": [{ "Id": "ExpireSyntheticLabData", "Status": "Enabled", "ExpirationInDays": 7, "NoncurrentVersionExpiration": { "NoncurrentDays": 7 }, "AbortIncompleteMultipartUpload": { "DaysAfterInitiation": 1 } }] },
        "OwnershipControls": { "Rules": [{ "ObjectOwnership": "BucketOwnerEnforced" }] },
        "PublicAccessBlockConfiguration": { "BlockPublicAcls": true, "BlockPublicPolicy": true, "IgnorePublicAcls": true, "RestrictPublicBuckets": true },
        "VersioningConfiguration": { "Status": "Enabled" },
        "Tags": [
          { "Key": "Environment", "Value": "synthetic-staging" },
          { "Key": "DataClassification", "Value": "synthetic_only" }
        ]
      }
    },
    "LabDocumentsBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": { "Ref": "LabDocumentsBucket" },
        "PolicyDocument": { "Version": "2012-10-17", "Statement": [
          { "Sid": "DenyInsecureTransport", "Effect": "Deny", "Principal": "*", "Action": "s3:*", "Resource": [{ "Fn::GetAtt": ["LabDocumentsBucket", "Arn"] }, { "Fn::Sub": "${LabDocumentsBucket.Arn}/*" }], "Condition": { "Bool": { "aws:SecureTransport": "false" } } },
          { "Sid": "DenyUnapprovedEncryption", "Effect": "Deny", "Principal": "*", "Action": "s3:PutObject", "Resource": { "Fn::Sub": "${LabDocumentsBucket.Arn}/*" }, "Condition": { "StringNotEquals": { "s3:x-amz-server-side-encryption": "aws:kms" } } },
          { "Sid": "DenyWrongKey", "Effect": "Deny", "Principal": "*", "Action": "s3:PutObject", "Resource": { "Fn::Sub": "${LabDocumentsBucket.Arn}/*" }, "Condition": { "StringNotEquals": { "s3:x-amz-server-side-encryption-aws-kms-key-id": { "Ref": "ClinicalCoreKeyArn" } } } }
        ] }
      }
    },
    "LabApiLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Delete",
      "UpdateReplacePolicy": "Delete",
      "Properties": { "LogGroupName": { "Fn::Sub": "/ai-clinical-core/synthetic-staging/lab-api-${ClinicalApiId}" }, "KmsKeyId": { "Ref": "ClinicalCoreKeyArn" }, "RetentionInDays": 14 }
    },
    "LabWorkerLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Delete",
      "UpdateReplacePolicy": "Delete",
      "Properties": { "LogGroupName": { "Fn::Sub": "/ai-clinical-core/synthetic-staging/lab-worker-${ClinicalApiId}" }, "KmsKeyId": { "Ref": "ClinicalCoreKeyArn" }, "RetentionInDays": 14 }
    },
    "LabApiRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Principal": { "Service": "lambda.amazonaws.com" }, "Action": "sts:AssumeRole" }] },
        "Policies": [
          { "PolicyName": "LabJobLedger", "PolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:DeleteItem", "dynamodb:ConditionCheckItem"], "Resource": { "Fn::GetAtt": ["LabJobTable", "Arn"] } }, { "Effect": "Allow", "Action": ["kms:Decrypt", "kms:GenerateDataKey"], "Resource": { "Ref": "ClinicalCoreKeyArn" } }] } },
          { "PolicyName": "LabDocumentUpload", "PolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject", "s3:DeleteObjectVersion"], "Resource": { "Fn::Sub": "${LabDocumentsBucket.Arn}/synthetic-labs/*" } }, { "Effect": "Allow", "Action": "s3:ListBucketVersions", "Resource": { "Fn::GetAtt": ["LabDocumentsBucket", "Arn"] }, "Condition": { "StringLike": { "s3:prefix": "synthetic-labs/*" } } }, { "Effect": "Allow", "Action": "kms:GenerateDataKey", "Resource": { "Ref": "ClinicalCoreKeyArn" } }] } },
          { "PolicyName": "LabUploadRecoveryExistence", "PolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": "s3:ListBucket", "Resource": { "Fn::GetAtt": ["LabDocumentsBucket", "Arn"] }, "Condition": { "StringLike": { "s3:prefix": "synthetic-labs/*" } } }] } },
          { "PolicyName": "LabWorkflowStart", "PolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": "states:StartExecution", "Resource": { "Fn::Sub": "arn:${AWS::Partition}:states:${AWS::Region}:${AWS::AccountId}:stateMachine:${ClinicalApiId}-synthetic-lab-analysis" } }] } },
          { "PolicyName": "LabApiLogs", "PolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": ["logs:CreateLogStream", "logs:PutLogEvents"], "Resource": { "Fn::GetAtt": ["LabApiLogGroup", "Arn"] } }] } }
        ]
      }
    },
    "LabSyntheticAuthorizerLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Delete",
      "UpdateReplacePolicy": "Delete",
      "Properties": { "LogGroupName": { "Fn::Sub": "/ai-clinical-core/synthetic-staging/lab-session-authorizer-${ClinicalApiId}" }, "KmsKeyId": { "Ref": "ClinicalCoreKeyArn" }, "RetentionInDays": 14 }
    },
    "LabWorkerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Principal": { "Service": "lambda.amazonaws.com" }, "Action": "sts:AssumeRole" }] },
        "Policies": [
          { "PolicyName": "LabWorkerLedger", "PolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": ["dynamodb:GetItem", "dynamodb:UpdateItem"], "Resource": { "Fn::GetAtt": ["LabJobTable", "Arn"] } }, { "Effect": "Allow", "Action": ["kms:Decrypt", "kms:GenerateDataKey"], "Resource": { "Ref": "ClinicalCoreKeyArn" } }] } },
          {"Fn::If":["ReviewedKnowledge",{"PolicyName":"PinnedReviewedKnowledge","PolicyDocument":{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Action":"s3:GetObjectVersion","Resource":{"Fn::Sub":"arn:${AWS::Partition}:s3:::${KnowledgeReleaseBucket}/${KnowledgeReleaseKey}"},"Condition":{"StringEquals":{"s3:VersionId":{"Ref":"KnowledgeReleaseObjectVersion"}}}}]}},{"Ref":"AWS::NoValue"}]},
          { "PolicyName": "LabWorkerDocuments", "PolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": ["s3:GetObject", "s3:PutObject"], "Resource": { "Fn::Sub": "${LabDocumentsBucket.Arn}/synthetic-labs/*" } }, { "Effect": "Allow", "Action": ["kms:Decrypt", "kms:GenerateDataKey"], "Resource": { "Ref": "ClinicalCoreKeyArn" } }] } },
          { "Fn::If": ["ReviewedRanges", { "PolicyName": "PinnedReviewedLabRanges", "PolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": "s3:GetObject", "Resource": { "Fn::Sub": "arn:${AWS::Partition}:s3:::${LabRangeReleaseBucket}/${LabRangeReleaseKey}" } }] } }, { "Ref": "AWS::NoValue" }] },
          { "PolicyName": "LabWorkerTextract", "PolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": ["textract:AnalyzeDocument", "textract:StartDocumentAnalysis", "textract:GetDocumentAnalysis"], "Resource": "*" }] } },
          { "PolicyName": "LabWorkerOpenAISecret", "PolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": "secretsmanager:GetSecretValue", "Resource": { "Ref": "OpenAISecretArn" } }] } },
          { "PolicyName": "LabWorkerLogs", "PolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": ["logs:CreateLogStream", "logs:PutLogEvents"], "Resource": { "Fn::GetAtt": ["LabWorkerLogGroup", "Arn"] } }] } }
        ]
      }
    },
    "LabSyntheticAuthorizerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Principal": { "Service": "lambda.amazonaws.com" }, "Action": "sts:AssumeRole" }] },
        "Policies": [{ "PolicyName": "SyntheticAuthorizerLogs", "PolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": ["logs:CreateLogStream", "logs:PutLogEvents"], "Resource": { "Fn::GetAtt": ["LabSyntheticAuthorizerLogGroup", "Arn"] } }] } }]
      }
    },
    "LabApiFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": { "Fn::Sub": "${ClinicalApiId}-synthetic-lab-api" },
        "Runtime": "nodejs22.x", "Architectures": ["arm64"], "Handler": "index.handler", "Role": { "Fn::GetAtt": ["LabApiRole", "Arn"] }, "MemorySize": 384, "Timeout": 20,
        "LoggingConfig": { "LogGroup": { "Ref": "LabApiLogGroup" }, "LogFormat": "JSON", "ApplicationLogLevel": "INFO", "SystemLogLevel": "WARN" },
        "Code": { "S3Bucket": { "Ref": "LambdaCodeBucket" }, "S3Key": { "Ref": "ApiCodeKey" } },
        "Environment": { "Variables": { "LAB_RANGE_MODE": { "Ref": "LabRangeMode" }, "LAB_RANGE_RELEASE_SHA256": { "Ref": "LabRangeReleaseSha256" }, "LAB_JOB_TABLE": { "Ref": "LabJobTable" }, "LAB_DOCUMENT_BUCKET": { "Ref": "LabDocumentsBucket" }, "LAB_KMS_KEY_ARN": { "Ref": "ClinicalCoreKeyArn" }, "LAB_STATE_MACHINE_ARN": { "Fn::Sub": "arn:${AWS::Partition}:states:${AWS::Region}:${AWS::AccountId}:stateMachine:${ClinicalApiId}-synthetic-lab-analysis" } } }
      }
    },
    "LabWorkerFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": { "Fn::Sub": "${ClinicalApiId}-synthetic-lab-worker" },
        "Runtime": "nodejs22.x", "Architectures": ["arm64"], "Handler": "index.handler", "Role": { "Fn::GetAtt": ["LabWorkerRole", "Arn"] }, "MemorySize": 1024, "Timeout": 300,
        "LoggingConfig": { "LogGroup": { "Ref": "LabWorkerLogGroup" }, "LogFormat": "JSON", "ApplicationLogLevel": "INFO", "SystemLogLevel": "WARN" },
        "Code": { "S3Bucket": { "Ref": "LambdaCodeBucket" }, "S3Key": { "Ref": "WorkerCodeKey" } },
        "Environment": {"Variables":{"LAB_RANGE_MODE":{"Ref":"LabRangeMode"},"LAB_RANGE_RELEASE_SHA256":{"Ref":"LabRangeReleaseSha256"},"LAB_RANGE_RELEASE_BUCKET":{"Ref":"LabRangeReleaseBucket"},"LAB_RANGE_RELEASE_KEY":{"Ref":"LabRangeReleaseKey"},"LAB_RANGE_SIGNER_PUBLIC_KEY_PEM":{"Ref":"LabRangeSignerPublicKeyPem"},"LAB_JOB_TABLE":{"Ref":"LabJobTable"},"LAB_DOCUMENT_BUCKET":{"Ref":"LabDocumentsBucket"},"LAB_KMS_KEY_ARN":{"Ref":"ClinicalCoreKeyArn"},"LAB_OPENAI_SECRET_ARN":{"Ref":"OpenAISecretArn"},"LAB_OPENAI_MODEL":{"Ref":"OpenAIModel"},"KNOWLEDGE_RELEASE_MODE":{"Ref":"KnowledgeReleaseMode"},"KNOWLEDGE_RELEASE_BUCKET":{"Ref":"KnowledgeReleaseBucket"},"KNOWLEDGE_RELEASE_KEY":{"Ref":"KnowledgeReleaseKey"},"KNOWLEDGE_RELEASE_OBJECT_VERSION":{"Ref":"KnowledgeReleaseObjectVersion"},"KNOWLEDGE_RELEASE_SHA256":{"Ref":"KnowledgeReleaseSha256"},"KNOWLEDGE_SOURCE_PACKAGE_SHA256":{"Ref":"KnowledgeSourcePackageSha256"},"KNOWLEDGE_SIGNER_PUBLIC_KEY_PEM":{"Ref":"KnowledgeSignerPublicKeyPem"}}}
      }
    },
    "LabSyntheticAuthorizerFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": { "Fn::Sub": "${ClinicalApiId}-synthetic-lab-session-authorizer" },
        "Runtime": "nodejs22.x", "Architectures": ["arm64"], "Handler": "index.authorizer", "Role": { "Fn::GetAtt": ["LabSyntheticAuthorizerRole", "Arn"] }, "MemorySize": 256, "Timeout": 10,
        "LoggingConfig": { "LogGroup": { "Ref": "LabSyntheticAuthorizerLogGroup" }, "LogFormat": "JSON", "ApplicationLogLevel": "ERROR", "SystemLogLevel": "WARN" },
        "Code": { "S3Bucket": { "Ref": "LambdaCodeBucket" }, "S3Key": { "Ref": "ApiCodeKey" } },
        "Environment": { "Variables": { "SYNTHETIC_SUPABASE_ISSUER": { "Ref": "SyntheticSupabaseIssuer" }, "SYNTHETIC_SUPABASE_AUDIENCE": { "Ref": "SyntheticSupabaseAudience" }, "SYNTHETIC_EMAIL_DOMAIN": { "Ref": "SyntheticEmailDomain" }, "SYNTHETIC_ORGANIZATION_ID": { "Ref": "SyntheticOrganizationId" }, "SYNTHETIC_ALLOWED_SUBJECTS": { "Ref": "SyntheticAllowedSubjects" } } }
      }
    },
    "LabStateMachineRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Principal": { "Service": "states.amazonaws.com" }, "Action": "sts:AssumeRole" }] },
        "Policies": [{ "PolicyName": "InvokeLabWorker", "PolicyDocument": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": "lambda:InvokeFunction", "Resource": [{ "Fn::GetAtt": ["LabWorkerFunction", "Arn"] }, { "Fn::Sub": "${LabWorkerFunction.Arn}:*" }] }] } }]
      }
    },
    "LabStateMachine": {
      "Type": "AWS::StepFunctions::StateMachine",
      "Properties": {
        "StateMachineName": { "Fn::Sub": "${ClinicalApiId}-synthetic-lab-analysis" },
        "StateMachineType": "STANDARD",
        "RoleArn": { "Fn::GetAtt": ["LabStateMachineRole", "Arn"] },
        "DefinitionString": {"Fn::Sub":"{\"StartAt\":\"Pass0\",\"States\":{\"Pass0\":{\"Type\":\"Task\",\"Resource\":\"${LabWorkerFunction.Arn}\",\"Parameters\":{\"jobId.$\":\"$.jobId\",\"pass\":0},\"ResultPath\":null,\"Retry\":[{\"ErrorEquals\":[\"lab_worker_busy\"],\"IntervalSeconds\":60,\"MaxAttempts\":7,\"BackoffRate\":1},{\"ErrorEquals\":[\"States.TaskFailed\"],\"IntervalSeconds\":2,\"MaxAttempts\":2,\"BackoffRate\":2}],\"Catch\":[{\"ErrorEquals\":[\"States.ALL\"],\"ResultPath\":\"$.failure\",\"Next\":\"FailJob0\"}],\"Next\":\"Pass1\"},\"Pass1\":{\"Type\":\"Task\",\"Resource\":\"${LabWorkerFunction.Arn}\",\"Parameters\":{\"jobId.$\":\"$.jobId\",\"pass\":1},\"ResultPath\":null,\"Retry\":[{\"ErrorEquals\":[\"lab_worker_busy\"],\"IntervalSeconds\":60,\"MaxAttempts\":7,\"BackoffRate\":1},{\"ErrorEquals\":[\"States.TaskFailed\"],\"IntervalSeconds\":2,\"MaxAttempts\":2,\"BackoffRate\":2}],\"Catch\":[{\"ErrorEquals\":[\"States.ALL\"],\"ResultPath\":\"$.failure\",\"Next\":\"FailJob1\"}],\"Next\":\"Pass2\"},\"Pass2\":{\"Type\":\"Task\",\"Resource\":\"${LabWorkerFunction.Arn}\",\"Parameters\":{\"jobId.$\":\"$.jobId\",\"pass\":2},\"ResultPath\":null,\"Retry\":[{\"ErrorEquals\":[\"lab_worker_busy\"],\"IntervalSeconds\":60,\"MaxAttempts\":7,\"BackoffRate\":1},{\"ErrorEquals\":[\"States.TaskFailed\"],\"IntervalSeconds\":2,\"MaxAttempts\":2,\"BackoffRate\":2}],\"Catch\":[{\"ErrorEquals\":[\"States.ALL\"],\"ResultPath\":\"$.failure\",\"Next\":\"FailJob2\"}],\"Next\":\"Pass3\"},\"Pass3\":{\"Type\":\"Task\",\"Resource\":\"${LabWorkerFunction.Arn}\",\"Parameters\":{\"jobId.$\":\"$.jobId\",\"pass\":3},\"ResultPath\":null,\"Retry\":[{\"ErrorEquals\":[\"lab_worker_busy\"],\"IntervalSeconds\":60,\"MaxAttempts\":7,\"BackoffRate\":1},{\"ErrorEquals\":[\"States.TaskFailed\"],\"IntervalSeconds\":2,\"MaxAttempts\":2,\"BackoffRate\":2}],\"Catch\":[{\"ErrorEquals\":[\"States.ALL\"],\"ResultPath\":\"$.failure\",\"Next\":\"FailJob3\"}],\"Next\":\"Pass4\"},\"Pass4\":{\"Type\":\"Task\",\"Resource\":\"${LabWorkerFunction.Arn}\",\"Parameters\":{\"jobId.$\":\"$.jobId\",\"pass\":4},\"ResultPath\":null,\"Retry\":[{\"ErrorEquals\":[\"lab_worker_busy\"],\"IntervalSeconds\":60,\"MaxAttempts\":7,\"BackoffRate\":1},{\"ErrorEquals\":[\"States.TaskFailed\"],\"IntervalSeconds\":2,\"MaxAttempts\":2,\"BackoffRate\":2}],\"Catch\":[{\"ErrorEquals\":[\"States.ALL\"],\"ResultPath\":\"$.failure\",\"Next\":\"FailJob4\"}],\"End\":true},\"FailJob0\":{\"Type\":\"Task\",\"Resource\":\"${LabWorkerFunction.Arn}\",\"Parameters\":{\"jobId.$\":\"$.jobId\",\"fail\":true,\"failureCategory.$\":\"$.failure.Error\",\"pass\":0},\"End\":true},\"FailJob1\":{\"Type\":\"Task\",\"Resource\":\"${LabWorkerFunction.Arn}\",\"Parameters\":{\"jobId.$\":\"$.jobId\",\"fail\":true,\"failureCategory.$\":\"$.failure.Error\",\"pass\":1},\"End\":true},\"FailJob2\":{\"Type\":\"Task\",\"Resource\":\"${LabWorkerFunction.Arn}\",\"Parameters\":{\"jobId.$\":\"$.jobId\",\"fail\":true,\"failureCategory.$\":\"$.failure.Error\",\"pass\":2},\"End\":true},\"FailJob3\":{\"Type\":\"Task\",\"Resource\":\"${LabWorkerFunction.Arn}\",\"Parameters\":{\"jobId.$\":\"$.jobId\",\"fail\":true,\"failureCategory.$\":\"$.failure.Error\",\"pass\":3},\"End\":true},\"FailJob4\":{\"Type\":\"Task\",\"Resource\":\"${LabWorkerFunction.Arn}\",\"Parameters\":{\"jobId.$\":\"$.jobId\",\"fail\":true,\"failureCategory.$\":\"$.failure.Error\",\"pass\":4},\"End\":true}}}"}
      }
    },
    "LabConsumerAuthorizer": {
